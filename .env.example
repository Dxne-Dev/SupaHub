NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_OAUTH_CLIENT_ID=votre_client_id
SUPABASE_OAUTH_CLIENT_SECRET=votre_client_secret


# Secret key (32 bytes hex ou string) pour chiffrer les tokens Supabase et identifiants BDD
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Cloudflare R2 Config
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=supahub-snapshots

# Cron Secret for Vercel/External Cron
CRON_SECRET=your-cron-secret

# Chariow — Paiement PRO
# Clé API Chariow (sk_live_...)
CHARIOW_API_KEY=sk_live_your_chariow_api_key
# ID ou slug du produit SupaHub PRO sur Chariow (ex: prd_abc123 ou supahub-pro)
CHARIOW_PRODUCT_ID=prd_your_product_id
# Secret de signature du Pulse webhook (whsec_...) — visible dans Automations > Pulses > Signing secret
CHARIOW_PULSE_SECRET=whsec_your_pulse_signing_secret
# URL publique du site (sans slash final) — utilisée pour le redirect post-paiement
NEXT_PUBLIC_SITE_URL=https://your-domain.com
